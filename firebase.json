{
    "hosting": {
        "public": "out",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "predeploy": ["npm run build"],
        "cleanUrls": true,
        "trailingSlash": false,
        "headers": [
            {
                "source": "/_next/static/**",
                "headers": [
                    { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
                ]
            }
        ]
    }
}
